<idea-plugin>
    <id>de.berger.gradletasksview</id>
    <name>Gradle Tasks Extended</name>
    <!-- Name, Version und Herausgeber traegt patchPluginXml aus gradle.properties ein. -->

    <!-- Sichtbar in der Plugin-Liste der IDE, deshalb englisch wie die uebrige Oberflaeche.
         Aendert sich der Funktionsumfang, gehoert dieser Text mit nachgezogen. -->
    <description><![CDATA[
        A standalone tool window for the Gradle tasks of the opened project, with three view
        modes: <em>Default</em> rebuilds the IDE's own Gradle view but turns the group rows
        into a folder tree, <em>Sort</em> lists the full group paths alphabetically, and
        <em>Nested</em> builds a folder hierarchy from slash-separated task groups. An
        optional module level can be switched on top of Sort and Nested.<br><br>
        Nodes can be hidden per module and per view mode, groups and tasks can carry their own
        icons, and Run, Debug and Run with Coverage are available from the context menu.
        Expand state, icons and hidden nodes are stored in two YAML files inside the project:
        a team default that is checked in, and personal overrides on top.<br><br>
        Built for private use; not distributed through the JetBrains Marketplace.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <!-- "com.intellij.gradle" ist die aktuelle Plugin-ID der Basis-Gradle-Integration
         (frueher/im Plan als "org.jetbrains.plugins.gradle" bezeichnet - diese ID gehoert
         inzwischen zum optionalen "Gradle for Java"-Sub-Plugin). Siehe ADR-002. -->
    <depends>com.intellij.gradle</depends>

    <resource-bundle>messages.GradleTasksViewBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Streifen-Icon: der Elefant aus dem Info-Dialog, auf den Kopf zugeschnitten -
             die ganze Figur zerfaellt bei 13 px zu einem Fleck (REQ-005, ADR-004). -->
        <toolWindow id="GradleTasksExtended"
                    factoryClass="de.berger.gradletasksview.toolwindow.GradleTasksExtendedToolWindowFactory"
                    anchor="right"
                    icon="/icons/toolWindowElefant.png"/>

        <!-- GradleTaskViewSettings und GradleTaskViewRefresher sind ueber @Service(Service.Level.PROJECT)
             bereits als "Light Services" registriert und werden hier bewusst NICHT zusaetzlich
             als projectService deklariert (das wuerde zu einer Doppelregistrierung fuehren). -->
        <postStartupActivity implementation="de.berger.gradletasksview.toolwindow.GradleTasksExtendedStartupActivity"/>
    </extensions>

    <actions>
        <group id="GradleTasksExtended.ContextMenu">
            <!-- Run, Debug, Run with Coverage: dynamisch aus den registrierten Executors,
                 als Kontext-Aktionen der Plattform (REQ-079, ADR-022). -->
            <group id="GradleTasksExtended.RunActions"
                   class="de.berger.gradletasksview.actions.GradleTaskRunActionGroup"/>
            <!-- "Modify Run Configuration ..." bzw. "Create ...", dieselbe Aktion wie im
                 Kontextmenue der originalen Gradle-Ansicht. -->
            <reference ref="ExternalSystem.CreateRunConfiguration"/>
            <separator/>
            <action id="GradleTasksExtended.CopyTaskName"
                    class="de.berger.gradletasksview.actions.GradleTaskCopyNameAction"/>
            <action id="GradleTasksExtended.CopyTaskPath"
                    class="de.berger.gradletasksview.actions.GradleTaskCopyPathAction"/>
            <action id="GradleTasksExtended.CopyFolderPath"
                    class="de.berger.gradletasksview.actions.GradleTaskCopyFolderPathAction"/>
            <separator/>
            <action id="GradleTasksExtended.ToggleHidden"
                    class="de.berger.gradletasksview.actions.GradleTaskToggleHiddenAction"/>
            <separator/>
            <action id="GradleTasksExtended.ExpandAll"
                    class="de.berger.gradletasksview.actions.GradleTaskExpandAllAction"/>
            <action id="GradleTasksExtended.CollapseAll"
                    class="de.berger.gradletasksview.actions.GradleTaskCollapseAllAction"/>
        </group>
    </actions>
</idea-plugin>
